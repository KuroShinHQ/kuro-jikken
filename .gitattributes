# Byte-pinned data. data/calibration.json records the size and sha256 of the
# locked ESOL predictions, so a checkout that rewrites line endings would change
# those bytes and make the audit fail (first seen on the Linux CI runner). The
# TDB files are hashed after CRLF->LF folding in tools/build_pool.py, so they
# need no rule here.
validation/solubility/*.csv text eol=crlf
