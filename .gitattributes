# Byte-pinned data. data/calibration.json records the size and sha256 of the
# locked ESOL predictions, and data/pool/alloy_phases.json records bytes and
# sha256 of the TDB files. A checkout that rewrites line endings changes those
# bytes and makes the audit fail (first seen on the Linux CI runner), so the
# line endings of these two families are pinned instead of normalised.
validation/solubility/*.csv text eol=crlf
data/alloy_tdb/*.tdb text eol=crlf
